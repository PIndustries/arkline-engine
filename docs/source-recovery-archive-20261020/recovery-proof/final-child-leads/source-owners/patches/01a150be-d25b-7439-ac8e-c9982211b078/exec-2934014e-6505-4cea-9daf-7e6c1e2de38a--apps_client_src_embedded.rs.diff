+#[derive(Clone, Debug)]
+pub struct CommandObservation {
+    pub debug: CommandTraceDebug,
+    /// Correlation ID and monotonic host age in milliseconds.
+    pub pending: Option<(u64, u64)>,
+    pub receipt: Option<RoomLightTrace>,
+    pub snapshot_age_ms: Option<u64>,
+    pub snapshot_confirmed: bool,
+    pub unavailable: Option<String>,
+}
+
+const COMMAND_TRACE_TIMEOUT: Duration = Duration::from_secs(3);
+
+#[derive(Default)]
+struct CommandDiagnostics {
+    sequence: u64,
+    pending: Option<(u64, Instant)>,
+    latest: Option<u64>,
+    vessel: Option<String>,
+    receipt: Option<RoomLightTrace>,
+    unknown: Option<String>,
+    authority_epoch: u64,
+}
+impl CommandDiagnostics {
+    fn expire(&mut self) {
+        if let Some((id, started)) = self.pending {
+            if started.elapsed() >= COMMAND_TRACE_TIMEOUT {
+                self.pending = None;
+                self.unknown = Some(format!("Command {id} outcome unknown after 3 seconds. Nothing was retried; inspect a later receipt or snapshot."));
+            }
+        }
+    }
+
+    fn accept(&mut self, receipt: &RoomLightTrace) {
+        if self.latest != Some(receipt.id) {
+            return;
+        }
+        if self.pending.is_some_and(|(id, _)| id == receipt.id) {
+            self.pending = None;
+        }
+        self.receipt = Some(receipt.clone());
+        self.unknown = None;
+    }
+
+    fn reset(&mut self, authority_epoch: u64) {
+        *self = Self {
+            sequence: self.sequence,
+            authority_epoch,
+            ..Default::default()
+        };
+    }
 }
