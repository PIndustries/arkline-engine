+//! Navigation, radar and camera feeds on the cockpit's physical display mounts.
 use super::*;
 
+/// The exact display-face plane used by the cockpit renderer. The caller passes
+/// its actual mount matrix; this helper never attaches a mount to the camera.
+#[derive(Clone)]
+pub(super) struct CockpitSurface {
+    viewport: egui::Rect,
+    canvas: egui::Rect,
+    local_to_clip: Mat4,
+    plane_x: f32,
+    center: Vec3,
+    half: Vec3,
+    bounds: egui::Rect,
+    index: usize,
+}
+
+#[derive(Clone, Copy)]
+struct SurfaceVertex {
+    clip: glam::Vec4,
+    uv: egui::Pos2,
+    color: egui::Color32,
+}
+
+impl SurfaceVertex {
+    fn lerp(self, other: Self, t: f32) -> Self {
+        let a = self.color.to_array();
+        let b = other.color.to_array();
+        let color: [u8; 4] = std::array::from_fn(|i| {
+            (f32::from(a[i]) + (f32::from(b[i]) - f32::from(a[i])) * t).round() as u8
+        });
+        Self {
+            clip: self.clip.lerp(other.clip, t),
+            uv: self.uv.lerp(other.uv, t),
+            color: egui::Color32::from_rgba_premultiplied(color[0], color[1], color[2], color[3]),
+        }
+    }
+}
+
+fn clip_surface_polygon(
+    input: Vec<SurfaceVertex>,
+    distance: impl Fn(SurfaceVertex) -> f32,
+) -> Vec<SurfaceVertex> {
+    let Some(mut previous) = input.last().copied() else { return input; };
+    let mut output = Vec::with_capacity(input.len() + 1);
+    let mut before = distance(previous);
+    for current in input {
+        let after = distance(current);
+        if (before >= 0.0) != (after >= 0.0) {
+            output.push(previous.lerp(current, before / (before - after)));
+        }
+        if after >= 0.0 { output.push(current); }
+        previous = current;
+        before = after;
+    }
+    output
+}
+
+fn clip_surface_frustum(mut polygon: Vec<SurfaceVertex>) -> Vec<SurfaceVertex> {
+    for plane in 0..7 {
+        polygon = clip_surface_polygon(polygon, |v| match plane {
+            0 => v.clip.w - 1e-6,
+            1 => v.clip.x + v.clip.w,
+            2 => v.clip.w - v.clip.x,
+            3 => v.clip.y + v.clip.w,
+            4 => v.clip.w - v.clip.y,
+            5 => v.clip.z + v.clip.w,
+            _ => v.clip.w - v.clip.z,
+        });
+        if polygon.is_empty() { break; }
+    }
+    polygon
+}
+
+impl CockpitSurface {
+    pub(super) fn new(
+        viewport: egui::Rect,
+        local_to_clip: Mat4,
+        class: ShipClass,
+        index: usize,
+        canvas_size: egui::Vec2,
+    ) -> Option<Self> {
+        if !viewport.is_finite() || viewport.width() <= 0.0 || viewport.height() <= 0.0
+            || !local_to_clip.is_finite() || !canvas_size.is_finite() || canvas_size.min_elem() <= 0.0 {
+            return None;
+        }
+        let (center, size) = *cockpit_screens(class).get(index)?;
+        let plane_x = center.x - 0.025 - 0.006;
+        // A perspective projection maps its camera center to (0,0,z,0).
+        // Recover it in mount-local coordinates to reject the display's back.
+        let camera = local_to_clip.inverse() * glam::Vec4::new(0.0, 0.0, 1.0, 0.0);
+        if !camera.is_finite() || camera.w.abs() < 1e-8 || camera.x / camera.w >= plane_x {
+            return None;
+        }
+        let mut result = Self {
+            viewport, canvas: egui::Rect::from_min_size(egui::Pos2::ZERO, canvas_size),
+            local_to_clip, plane_x, center,
+            half: Vec3::new(0.0, size.y - 0.008, size.z - 0.008),
+            bounds: egui::Rect::NOTHING, index,
+        };
+        let corners = [result.canvas.left_top(), result.canvas.right_top(), result.canvas.right_bottom(), result.canvas.left_bottom()];
+        let polygon = clip_surface_frustum(corners.into_iter().map(|p| result.vertex(p, egui::Pos2::ZERO, egui::Color32::WHITE)).collect());
+        for vertex in polygon { result.bounds.extend_with(result.screen_position(vertex.clip)?); }
+        if !result.bounds.is_finite() || result.bounds.width() < 1.0 || result.bounds.height() < 1.0 { return None; }
+        Some(result)
+    }
+
+    pub(super) fn canvas_rect(&self) -> egui::Rect { self.canvas }
+    pub(super) fn bounds(&self) -> egui::Rect { self.bounds }
+    pub(super) fn contains(&self, point: egui::Pos2) -> bool { self.unproject(point).is_some() }
+
+    pub(super) fn unproject(&self, point: egui::Pos2) -> Option<egui::Pos2> {
+        let (origin, direction) = screen_ray(self.local_to_clip, self.viewport, point)?;
+        if direction.x.abs() < 1e-7 { return None; }
+        let t = (self.plane_x - origin.x) / direction.x;
+        if !t.is_finite() || t < 0.0 { return None; }
+        let hit = origin + direction * t;
+        let clip = self.local_to_clip * hit.extend(1.0);
+        if !clip.is_finite() || clip.w <= 0.0 || clip.z < -clip.w || clip.z > clip.w { return None; }
+        let u = (hit.z - self.center.z) / (2.0 * self.half.z) + 0.5;
+        let v = 0.5 - (hit.y - self.center.y) / (2.0 * self.half.y);
+        if !(0.0..=1.0).contains(&u) || !(0.0..=1.0).contains(&v) { return None; }
+        Some(self.canvas.min + egui::vec2(u * self.canvas.width(), v * self.canvas.height()))
+    }
+
+    fn vertex(&self, point: egui::Pos2, uv: egui::Pos2, color: egui::Color32) -> SurfaceVertex {
+        let u = (point.x - self.canvas.left()) / self.canvas.width();
+        let v = (point.y - self.canvas.top()) / self.canvas.height();
+        let local = Vec3::new(self.plane_x, self.center.y + (0.5 - v) * self.half.y * 2.0,
+            self.center.z + (u - 0.5) * self.half.z * 2.0);
+        SurfaceVertex { clip: self.local_to_clip * local.extend(1.0), uv, color }
+    }
+
+    fn screen_position(&self, clip: glam::Vec4) -> Option<egui::Pos2> {
+        if !clip.is_finite() || clip.w <= 1e-7 { return None; }
+        Some(self.viewport.center() + egui::vec2(clip.x / clip.w * self.viewport.width() * 0.5,
+            -clip.y / clip.w * self.viewport.height() * 0.5))
+    }
+
+    fn project_mesh(&self, mesh: egui::epaint::Mesh, local_clip: egui::Rect) -> egui::epaint::Mesh {
+        let clip = local_clip.intersect(self.canvas);
+        let mut output = egui::epaint::Mesh::with_texture(mesh.texture_id);
+        for triangle in mesh.indices.chunks_exact(3) {
+            // Clip local content first, including glyphs that cross the bezel.
+            let mut polygon: Vec<_> = triangle.iter().map(|i| {
+                let v = mesh.vertices[*i as usize];
+                SurfaceVertex { clip: glam::Vec4::new(v.pos.x, v.pos.y, 0.0, 1.0), uv: v.uv, color: v.color }
+            }).collect();
+            for edge in 0..4 {
+                polygon = clip_surface_polygon(polygon, |v| match edge {
+                    0 => v.clip.x - clip.left(), 1 => clip.right() - v.clip.x,
+                    2 => v.clip.y - clip.top(), _ => clip.bottom() - v.clip.y,
+                });
+            }
+            let polygon = clip_surface_frustum(polygon.into_iter().map(|v| self.vertex(egui::pos2(v.clip.x, v.clip.y), v.uv, v.color)).collect());
+            let start = output.vertices.len() as u32;
+            for v in &polygon {
+                if let Some(pos) = self.screen_position(v.clip) {
+                    output.vertices.push(egui::epaint::Vertex { pos, uv: v.uv, color: v.color });
+                }
+            }
+            for index in 1..polygon.len().saturating_sub(1) {
+                output.add_triangle(start, start + index as u32, start + index as u32 + 1);
+            }
+        }
+        output
+    }
+
+    /// Collect ordinary egui shapes in display-local coordinates. The guard
+    /// tessellates and projects them (including font glyphs) onto this real face.
+    pub(super) fn begin_paint(&self, ui: &egui::Ui) -> SurfacePaint {
+        let layer = egui::LayerId::new(egui::Order::Background, egui::Id::new(("cockpit_surface_canvas", self.index)));
+        SurfacePaint {
+            surface: self.clone(), output: ui.painter_at(self.viewport),
+            painter: egui::Painter::new(ui.ctx().clone(), layer, self.canvas), layer,
+        }
+    }
+}
+
+pub(super) struct SurfacePaint { surface: CockpitSurface, output: egui::Painter, painter: egui::Painter, layer: egui::LayerId }
+impl SurfacePaint { pub(super) fn painter(&self) -> &egui::Painter { &self.painter } }
+impl Drop for SurfacePaint {
+    fn drop(&mut self) {
+        let context = self.painter.ctx();
+        let shapes = context.graphics_mut(|graphics| {
+            let list = graphics.entry(self.layer);
+            let shapes: Vec<_> = list.all_entries().cloned().collect();
+            *list = Default::default();
+            shapes
+        });
+        for primitive in context.tessellate(shapes, context.pixels_per_point()) {
+            if let egui::epaint::Primitive::Mesh(mesh) = primitive.primitive {
+                let mesh = self.surface.project_mesh(mesh, primitive.clip_rect);
+                if !mesh.indices.is_empty() { self.output.add(egui::Shape::mesh(mesh)); }
+            }
+        }
+    }
+}
