  "selected_refinements": [
    {
      "area": "Bridge joints",
      "status": "clear",
      "actual_observation": "Both front diagonal bars visibly meet the inner frame corners/gasket junctions. Prior floating partial strips are gone. Continuous frame/reveal and bow-lamp mounts remain legible in pane close-up."
    },
    {
      "area": "Three brow plates",
      "status": "clear",
      "actual_observation": "Three thick faceted plates have visible raised edges and dark recessed joints, plus a small service pocket. Close bridge-quarter shows constructed plate thickness instead of seam lines laid over a single plane."
    },
    {
      "area": "Roof handling architecture",
      "status": "clear_for_authored_static_scope",
      "actual_observation": "Raised metallic paired links, yellow/metal pivot details, base and folded/stow relationship are readable in aft-roof close view. Recessed work/service deck stays open and distinct from former repeated roof lids."
    },
    {
      "area": "Aft flange and openings",
      "status": "clear",
      "actual_observation": "Old dense striped/jagged rim band in7038closeup is absent in7040. A thin continuous seated outer rim and interior bell/throat depth are visible. Both rear openings remain distinct."
    },
    {
      "area": "Powered glass and existing turrets",
      "status": "clear_for_presentation",
      "actual_observation": "Glazing is restrained dark/navy teal with visible framing instead of flat-white luminous cards; lamps remain readable. Both existing gun assemblies remain visible on their fore-roof support."
    }
  ],
  "remaining_gaps": [
    "Opaque material contract remains: dark restrained panes do not establish transparent glass, interior reflections or a fitted bridge.",
    "Stowed arm is fixed decorative source geometry; close-view readability does not prove operation, rigging or clearances. Its normal-quarter prominence remains lower than the concept raised crane.",
    "Side bays/collars, underside steps, equipment variation and overall v05 silhouette/detail remain visibly unfinished.",
    "Source counterbore floor faces remain mutually coincident behind the seated flange. This was disclosed by source audit; no global overlap-free claim is made.",
    "Turret articulation/firing, fitted interiors, physical systems and engineering adequacy remain separate scope."
  ],
